generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String    @default("")
  email         String    @unique
  password      String
  image_link    String    @default("")
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sessions            Session[]
  hostedMeetings      Meeting[] @relation("MeetingHost")
  hostedConsultation Consultation[] @relation("ConsultationHost")
  withConsultation Consultation[] @relation("ConsultationWith")

  @@map("app_user")
}

model Session {
  id         String   @id @default(uuid())
  userAgent  String
  ipAddress  String
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

   // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int

   @@map("user_session")
}
model Meeting {
  id            String        @id @default(cuid())
  title         String
  description   String?
  scheduledDate DateTime
  reminder      ReminderType?
  uniqueCode    String        @unique
  meetingLink   String
  status        MeetingStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Relations
  host         User                @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  hostId       Int

  @@map("meeting")
}
model Consultation{
  id            String        @id @default(cuid())
  date DateTime
  type      ConsultationType?
  status      MeetingStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Relations
  host         User                @relation("ConsultationHost", fields: [hostId], references: [id], onDelete: Cascade)
  hostId       Int
  with        User                @relation("ConsultationWith", fields: [withId], references: [id], onDelete: Cascade)
    withId   Int
  @@map("consultation")

}
enum ReminderType {
  NONE
  AT_TIME
  FIVE_MINUTES
  TEN_MINUTES
  FIFTEEN_MINUTES
  THIRTY_MINUTES
  ONE_HOUR
  TWO_HOURS
  ONE_DAY
  TWO_DAYS
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ConsultationType{
  GENENAL
  TRACKING
  SPECIAL
}
